{
  "mcpServers": {
    "github": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-e",
        "GITHUB_PERSONAL_ACCESS_TOKEN",
        "ghcr.io/github/github-mcp-server"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    },
    "amap-maps": {
      "command": "D:\\install\\nodjs\\node-v24.22.1-win-x64\\node.exe",
      "args": [
        "D:\\install\\nodjs\\node-v24.22.1-win-x64\\node_global\\node_modules\\@amap\\amap-maps-mcp-server\\build\\index.js"
      ],
      "env": {
        "AMAP_MAPS_API_KEY": "${AMAP_MAPS_API_KEY}"
      }
    }
  }
}